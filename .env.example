# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/metaverse?sslmode=disable

# JWT Secret Key
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Ports
HTTP_PORT=3000
WS_PORT=3001

# Frontend URL — used for CORS and for the Google OAuth success/error redirect.
# Local dev: http://localhost:5173  |  Production: your deployed frontend origin.
FRONTEND_URL=http://localhost:5173

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_REDIRECT_URL must EXACTLY match an Authorized redirect URI in the
# Google console, and point at the HTTP server's callback route below.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
